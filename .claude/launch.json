{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pandadventures",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 8070
    },
    {
      "name": "web-build",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "tools/serve_web.py",
        "8060",
        "build/web"
      ],
      "port": 8060
    },
    {
      "name": "pandadventures-phone",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/node_modules/vite/bin/vite.js",
        "web",
        "--host",
        "0.0.0.0",
        "--port",
        "8071",
        "--strictPort"
      ],
      "port": 8071
    },
    {
      "name": "pandadventures-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "web/node_modules/vite/bin/vite.js",
        "preview",
        "web",
        "--port",
        "8073",
        "--strictPort"
      ],
      "port": 8073
    }
  ]
}